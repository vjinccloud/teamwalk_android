<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12 (API 31) 以後的 Auto Backup / Device Transfer 規則。
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- Google Drive 雲端備份還原（換機/重裝同帳號還原時觸發） -->
    <cloud-backup>
        <exclude domain="file" path="PersistedInstallation."/>
        <exclude domain="file" path="PersistedInstallationEntry"/>
        <exclude domain="file" path="datastore/"/>
        <exclude domain="sharedpref" path="teamwalk2_tink_keyset_prefs.xml"/>
    </cloud-backup>

    <!-- 裝置之間直接轉移（Smart Switch / Pixel 換機）也要排除，避免 OEM 工具帶走 -->
    <device-transfer>
        <exclude domain="file" path="PersistedInstallation."/>
        <exclude domain="file" path="PersistedInstallationEntry"/>
        <exclude domain="file" path="datastore/"/>
        <exclude domain="sharedpref" path="teamwalk2_tink_keyset_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
